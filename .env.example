# Database
# USER: db username
# PASSWORD: db password
# SERVER: db server name
# DB: db name
DATABASE_URL="postgresql://USER:PASSWORD@SERVER:5432/DB?schema=public"
# Optional: direct (non-pooled) connection string, used only by the Prisma CLI
# (migrate/db push/introspect). Required on providers whose main URL goes
# through a transaction-mode pooler (e.g. Neon's "-pooler" endpoint) — the
# Prisma CLI relies on Postgres advisory locks, which don't work reliably
# through that kind of pooler and make `migrate deploy` hang/fail with P1002.
# Falls back to DATABASE_URL when unset (e.g. local Postgres, no pooler).
# DIRECT_URL="postgresql://USER:PASSWORD@SERVER-DIRECT:5432/DB?schema=public"

# NextAuth
# using for generated NEXTAUTH_SECRET: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here"

# App
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=financial_db

# ADMIN CREDENTIALS
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

NEXT_PUBLIC_APP_NAME="Controle Financeiro"
# Optional: overrides the app's public base URL used to build absolute links
# (e.g. e-mail buttons, WhatsApp images). Defaults to NEXTAUTH_URL when unset.
# NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secret for the scheduled e-mails cron route (GET /api/cron/scheduled-emails
# with header "Authorization: Bearer <CRON_SECRET>"). Generate: openssl rand -base64 32
CRON_SECRET=""

# Google Gemini AI
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-google-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# Performance / infraestrutura (todas opcionais em dev: sem elas o app roda
# sem Redis, sem fila e grava uploads em public/uploads)
# ---------------------------------------------------------------------------

# URL pública da aplicação usada pelo QStash para chamar /api/jobs/* (cai para NEXTAUTH_URL)
# APP_URL="https://seu-app.vercel.app"

# Pool de conexões por instância (serverless: mantenha baixo e use o endpoint "-pooler" do Neon)
DATABASE_POOL_MAX=5

# Upstash Redis (cache). A integração da Vercel também define KV_REST_API_URL/KV_REST_API_TOKEN.
# Dev local: `docker compose --profile cache up -d redis redis-http` e use os valores abaixo.
# UPSTASH_REDIS_REST_URL="http://localhost:8079"
# UPSTASH_REDIS_REST_TOKEN="local-dev-token"

# Upstash QStash (fila de tarefas lentas). Dev local: `npx @upstash/qstash-cli dev`
# e copie as chaves impressas; QSTASH_URL só é necessário no modo local.
# QSTASH_TOKEN=""
# QSTASH_CURRENT_SIGNING_KEY=""
# QSTASH_NEXT_SIGNING_KEY=""
# QSTASH_URL="http://127.0.0.1:8080"

# Vercel Blob (uploads servidos pela CDN). Sem ele, os uploads vão para public/uploads.
# BLOB_READ_WRITE_TOKEN=""

# Observabilidade: spans acima deste tempo (ms) são logados como `otel.slow_span`
SLOW_REQUEST_MS=1000
# Exportação OTLP opcional (Grafana, Honeycomb, Jaeger…). Na Vercel, a integração é automática.
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
# Dev: avisa quando um único render faz mais queries que isso (sinal de N+1)
PRISMA_QUERY_WARN=30
