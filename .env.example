# Database
# USER: db username
# PASSWORD: db password
# SERVER: db server name
# DB: db name
DATABASE_URL="postgresql://USER:PASSWORD@SERVER:5432/DB?schema=public"

# NextAuth
# using for generated NEXTAUTH_SECRET: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here"

# App
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=financial_db

# ADMIN CREDENTIALS
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

NEXT_PUBLIC_APP_NAME="Controle Financeiro"
# Optional: overrides the app's public base URL used to build absolute links
# (e.g. e-mail buttons, WhatsApp images). Defaults to NEXTAUTH_URL when unset.
# NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Gemini AI
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-google-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
